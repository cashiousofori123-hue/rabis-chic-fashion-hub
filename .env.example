RABI_ADMIN_EMAIL=client@example.com
# Optional aliases for the single-device admin login. ADMIN_PASSWORD, when set, replaces the stored admin password check.
# ADMIN_EMAIL=client@example.com
# ADMIN_PASSWORD=use-a-unique-secret-and-never-commit-it
RABI_SECRET_KEY=replace-with-a-random-secret-before-deploying
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional background push notifications for admin devices (generate a VAPID key pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rabischic.com
GEMINI_API_KEY=your_free_key_from_aistudio
GEMINI_MODEL=gemini-flash-latest
RABI_ADMIN_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
